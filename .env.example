# Copy to .env.local. The shop builds and runs with every value blank:
# catalog, cart, and checkout fall back to the seeded demo.

# Public site URL used for Stripe return links. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project. Both are required before auth, the database cart, and admin writes turn on.
# Use the publishable (anon) key here. Never put the service role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by the Stripe webhook to insert orders and decrement stock.
# Bypasses row level security. Do not expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe test-mode keys. Checkout stays a simulated success until STRIPE_SECRET_KEY is set.
# The webhook also needs the signing secret from `stripe listen` or the Dashboard endpoint.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend free tier. Order email is skipped, and checkout still succeeds, when this is empty.
# The default onboarding sender can only deliver to the email on your Resend account.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Oak & Ember <onboarding@resend.dev>
